+bool RealtimeSession::recover_decoder_eos(
+    EngineStream & stream, TerminalEvents & terminal, const char * reason)
+{
+    if (cancellation_->requested()) return false;
+    const voxtral_stream_metrics before = stream.metrics();
+    const std::uint64_t accepted = before.audio_samples_accepted;
+    const std::uint64_t boundary = std::min(
+        accepted, terminal.eos_audio_end_ms * 16u);
+    const std::size_t replay_count = static_cast<std::size_t>(std::min(
+        accepted - boundary, static_cast<std::uint64_t>(recent_pcm_.size())));
+    std::vector<std::int16_t> tail;
+    tail.reserve(replay_count);
+    tail.insert(tail.end(), recent_pcm_.end() - replay_count, recent_pcm_.end());
+
+    if (!segment_partial_.empty()) {
+        transcript_prefix_ += segment_partial_;
+        if (transcript_prefix_.back() != ' ') transcript_prefix_ += ' ';
+    }
+    audio_epoch_samples_ += accepted - replay_count;
+    const voxtral_status status = stream.reset_for_continuation();
+    if (status != VOXTRAL_STATUS_OK)
+        throw EngineError(status, stream.last_error());
+    recent_pcm_.clear();
+    recent_activity_.clear();
+    epoch_samples_fed_ = 0;
+    last_decoder_audio_sample_ = 0;
+    last_lexical_audio_sample_ = 0;
+    quiet_samples_ = 0;
+    quiet_observed_ = false;
+    pad_run_tokens_ = 0;
+    meaningful_lexical_tokens_since_recovery_ = 0;
+    meaningful_visible_chars_since_recovery_ = 0;
+    last_decoder_recovery_at_ = std::chrono::steady_clock::now();
+    if (std::string_view(reason) == "blank_pad") ++consecutive_blank_recoveries_;
+    segment_partial_.clear();
+    terminal.eos_seen = false;
+    terminal.eos_audio_end_ms = 0;
+    ++eos_recoveries_;
+    app_.logger().info(std::string_view(reason) == "eos"
+        ? "realtime_decoder_eos_recovered" : "realtime_decoder_blank_recovered", {
+        {"session_id", session_id_},
+        {"reason", reason},
+        {"recoveries", eos_recoveries_},
+        {"failed_recovery_attempts", consecutive_blank_recoveries_},
+        {"audio_offset_ms", audio_epoch_samples_ / 16u},
+        {"replayed_ms", replay_count / 16u},
+    });
+    // No model load, lease release, or WebSocket handshake is needed.
+    if (std::string_view(reason) == "blank_pad" &&
+        !enqueue_mandatory_from_worker(recovery_warning_json(
+            "decoder_blank_recovered", consecutive_blank_recoveries_,
+            meaningful_lexical_tokens_since_recovery_,
+            meaningful_visible_chars_since_recovery_, replay_count / 16u,
+            audio_epoch_samples_ / 16u))) return false;
+    return tail.empty() || feed_audio(stream, tail, terminal);
+}
+
+bool RealtimeSession::should_recover_blank_rut() const {
+    if (pad_run_tokens_ < 25u || consecutive_blank_recoveries_ >= 2u ||
+        last_decoder_audio_sample_ < last_lexical_audio_sample_ + 48000u ||
+        (!quiet_observed_ && !segment_partial_.empty()) ||
+        std::chrono::steady_clock::now() - last_decoder_recovery_at_ <
+            std::chrono::seconds(15)) return false;
+    const std::uint64_t cutoff = last_decoder_audio_sample_ > 48000u
+        ? last_decoder_audio_sample_ - 48000u : 0;
+    const std::uint64_t current_cutoff = last_decoder_audio_sample_ > 8000u
+        ? last_decoder_audio_sample_ - 8000u : 0;
+    std::uint64_t active_samples = 0;
+    std::uint64_t current_active_samples = 0;
+    for (const AudioActivity & region : recent_activity_) {
+        if (region.rms < 0.0035 || region.start >= last_decoder_audio_sample_ ||
+            region.end <= cutoff) continue;
+        active_samples += std::min(region.end, last_decoder_audio_sample_) -
+            std::max(region.start, cutoff);
+        if (region.end > current_cutoff) {
+            current_active_samples += std::min(region.end, last_decoder_audio_sample_) -
+                std::max(region.start, current_cutoff);
+        }
+    }
+    // At least 400ms of non-silent audio must have reached the decoder, with
+    // 160ms in its latest 500ms. A just-completed phrase followed by quiet must
+    // not cause a reset simply because speech remains in the three-second tail.
+    // Noise
+    // cannot cause an endless refresh cycle: cooldown and a two-attempt cap
+    // apply until actual lexical output demonstrates progress.
+    return active_samples >= 6400u && current_active_samples >= 2560u;
+}

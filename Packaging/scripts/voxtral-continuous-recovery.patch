+// Count visible letters/digits/ideographs, not UTF-8 bytes. Partial snapshots
+// already end at a complete UTF-8 boundary, so split token pieces cannot inflate
+// the recovery-success threshold. Common Unicode punctuation is excluded.
+std::uint64_t meaningful_visible_characters(std::string_view text) {
+    std::uint64_t count = 0;
+    for (std::size_t i = 0; i < text.size();) {
+        const unsigned char lead = static_cast<unsigned char>(text[i++]);
+        if (lead < 0x80) {
+            if (std::isalnum(lead) != 0) ++count;
+            continue;
+        }
+        std::uint32_t codepoint = 0;
+        unsigned continuation = 0;
+        if ((lead & 0xE0) == 0xC0) { codepoint = lead & 0x1F; continuation = 1; }
+        else if ((lead & 0xF0) == 0xE0) { codepoint = lead & 0x0F; continuation = 2; }
+        else if ((lead & 0xF8) == 0xF0) { codepoint = lead & 0x07; continuation = 3; }
+        else continue;
+        bool valid = i + continuation <= text.size();
+        for (unsigned j = 0; valid && j < continuation; ++j) {
+            const unsigned char byte = static_cast<unsigned char>(text[i++]);
+            valid = (byte & 0xC0) == 0x80;
+            codepoint = (codepoint << 6) | (byte & 0x3F);
+        }
+        if (!valid) continue;
+        if (codepoint == 0xA0 || (codepoint >= 0x2000 && codepoint <= 0x206F) ||
+            (codepoint >= 0x3000 && codepoint <= 0x303F) ||
+            (codepoint >= 0xFF01 && codepoint <= 0xFF0F) ||
+            (codepoint >= 0xFF1A && codepoint <= 0xFF20) ||
+            (codepoint >= 0xFF3B && codepoint <= 0xFF40) ||
+            (codepoint >= 0xFF5B && codepoint <= 0xFF65)) continue;
+        ++count;
+    }
+    return count;
+}
